{% extends "layout/header.html.twig" %}

{% block dd_layout_page_header_icon_menu_account %}
    {{ parent() }}

    {% if oxcmp_user %}
        <span id="oeem-greeting-btn-wrapper" class="d-none"
              data-stoken="{{ oViewConf.getSessionChallengeToken() }}">
            <a id="oeem-greeting-btn"
               class="btn btn-sm btn-outline-primary ms-2"
               href="">
                {{ translate({ ident: "OEEXAMPLESMODULE_GREETING_UPDATE" }) }}
            </a>
        </span>

        {{ style({ include: oViewConf.getModuleUrl('oe_examples_module', 'out/build/css/examplesmodule_style.min.css') }) }}
        {{ script({ include: oViewConf.getModuleUrl('oe_examples_module', 'out/build/js/main.min.js') }) }}
    {% endif %}
{% endblock %}
